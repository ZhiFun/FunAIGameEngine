# SCREENTEST —— 屏幕/画布自检
# 用途: 换屏幕或改分辨率后, 确认整个画布区域都能画出来。
# 打包: py -3 tools\engine.py pack screentest

var t = 0

on update {
    t = t + 1
}

on render {
    clear(RGB(8, 10, 24))

    # 四边边框(应为闭合矩形, 贴着屏幕四边)
    rect(0, 0, 428, 142, RGB(0, 255, 0))

    # 不同高度的色条: 用来判断画布实际可绘制到多低
    frect(10, 10, 60, 8, RGB(255, 0, 0))
    frect(10, 50, 60, 8, RGB(255, 160, 0))
    frect(10, 90, 60, 8, RGB(0, 128, 255))
    frect(10, 130, 60, 8, RGB(255, 0, 255))

    # 右半屏同样来一组, 确认横向也铺满
    frect(358, 10, 60, 8, RGB(255, 0, 0))
    frect(358, 130, 60, 8, RGB(255, 0, 255))

    # 文字: 顶部与底部各一行
    text(90, 10, "TOP", RGB(255, 255, 255), 1)
    text(90, 130, "BOTTOM", RGB(255, 255, 255), 1)
}
